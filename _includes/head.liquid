<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

{% assign page_title = page.title | default: site.first_name | append: ' ' | append: site.last_name %}
{% if page.url == '/' %}
  {% assign full_title = site.first_name | append: ' ' | append: site.last_name %}
{% else %}
  {% assign full_title = page_title | append: ' · ' | append: site.first_name | append: ' ' | append: site.last_name %}
{% endif %}
{% assign page_description = page.description | default: site.description | strip_newlines | strip %}

<title>{{ full_title }}</title>
<meta name="description" content="{{ page_description | strip_html | escape }}">
<meta name="author" content="{{ site.first_name }} {{ site.last_name }}">
{% if site.keywords %}
  <meta name="keywords" content="{{ site.keywords }}">
{% endif %}
<link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">

<meta property="og:type" content="{% if page.layout == 'post' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ full_title | escape }}">
<meta property="og:description" content="{{ page_description | strip_html | escape }}">
<meta property="og:url" content="{{ page.url | absolute_url }}">
<meta property="og:site_name" content="{{ site.first_name }} {{ site.last_name }}">

<link rel="alternate" type="application/rss+xml" href="{{ '/feed.xml' | absolute_url }}" title="{{ site.first_name }} {{ site.last_name }}">

<link
  rel="icon"
  href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
>

<link rel="preload" href="{{ '/assets/fonts/site/inter-latin.woff2' | relative_url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ '/assets/fonts/site/source-serif-4-latin.woff2' | relative_url }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_file_cache }}">

<!-- Theme is resolved before first paint so the page never flashes. -->
<script>
  (function () {
    var stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch (e) {}
    var system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', stored || system);
  })();
</script>
