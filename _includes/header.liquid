<header class="site-header">
  <div class="wrap">
    <a class="site-title" href="{{ '/' | relative_url }}">
      {{- site.first_name }}
      {{ site.last_name -}}
    </a>

    <nav class="site-nav" aria-label="Main">
      {%- assign nav_pages = site.pages | where: 'nav', true | sort: 'nav_order' -%}
      {%- for p in nav_pages -%}
        {%- comment -%}
          jekyll-paginate-v2 rewrites the permalink of a paginated page to
          .../index.html, so strip it rather than link to the file directly.
        {%- endcomment -%}
        {%- assign nav_url = p.permalink | default: p.url | replace: 'index.html', '' -%}
        {%- assign is_current = false -%}
        {%- if nav_url == '/' -%}
          {%- if page.url == '/' -%}{%- assign is_current = true -%}{%- endif -%}
        {%- elsif page.url contains nav_url -%}
          {%- assign is_current = true -%}
        {%- endif -%}
        <a
          href="{{ nav_url | relative_url }}"
          {% if is_current %}
            aria-current="page"
          {% endif %}
        >
          {{- p.title -}}
        </a>
      {%- endfor %}

      <button id="theme-toggle" type="button" title="Change theme" aria-label="Change theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M12 3v1.5M12 19.5V21M4.2 4.2l1.1 1.1M18.7 18.7l1.1 1.1M3 12h1.5M19.5 12H21M4.2 19.8l1.1-1.1M18.7 5.3l1.1-1.1"></path>
          <circle cx="12" cy="12" r="3.6"></circle>
        </svg>
      </button>
    </nav>
  </div>
</header>
