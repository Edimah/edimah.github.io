---
layout: default
---
<div class="prose">
  <header class="post-header">
    <h1>
      {% if page.type == 'year' %}
        {{ page.date | date: '%Y' }}
      {% elsif page.type == 'tags' %}
        {{ page.title }}
      {% else %}
        {{ page.title }}
      {% endif %}
    </h1>
    <p class="meta">
      {{ page.posts | size }}
      {% if page.posts.size == 1 %}post{% else %}posts{% endif %}
      <span class="sep">·</span><a href="{{ '/blog/' | relative_url }}">all writing</a>
    </p>
  </header>
</div>

<ul class="post-list">
  {% for post in page.posts %}
    <li>
      <h3>
        <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
      </h3>
      {% if post.description %}
        <p>{{ post.description }}</p>
      {% endif %}
      <p class="meta">
        <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%-d %B %Y' }}</time>
      </p>
    </li>
  {% endfor %}
</ul>
