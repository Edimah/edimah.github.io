---
layout: default
---
<article class="prose">
  <header class="post-header">
    <h1>{{ page.title }}</h1>
    {% if page.description %}
      <p class="description">{{ page.description }}</p>
    {% endif %}
    <p class="meta">
      <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%-d %B %Y' }}</time>
      {% assign read_time = content | number_of_words | divided_by: 180 | plus: 1 %}
      <span class="sep">·</span>{{ read_time }} min read
      {% if page.tags.size > 0 %}
        <span class="sep">·</span>
        {% for tag in page.tags %}
          <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">{{ tag }}</a>
          {%- unless forloop.last %}, {% endunless -%}
        {% endfor %}
      {% endif %}
    </p>
  </header>

  {{ content }}

  <footer class="post-footer">
    <nav class="post-nav" aria-label="More posts">
      {% if page.previous.url %}
        <a class="prev" href="{{ page.previous.url | relative_url }}">
          <span class="dir">Previous</span>
          {{ page.previous.title }}
        </a>
      {% endif %}
      {% if page.next.url %}
        <a class="next" href="{{ page.next.url | relative_url }}">
          <span class="dir">Next</span>
          {{ page.next.title }}
        </a>
      {% endif %}
    </nav>
  </footer>
</article>
